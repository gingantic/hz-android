<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Storage access for media files -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Full file-system access (for file browser on Android 11+).
         Not requested at runtime — user must enable it manually
         via Settings → "Full storage access". -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Audio focus and background playback -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- API 33+: required for NSD/mDNS service discovery (subnet scan still works without it) -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <application
        android:name=".HzPlayerApplication"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HzPlayer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HzPlayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Register as a video player -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- Register as an audio player -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- Specific video container MIME types not always covered by video/* -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/x-matroska" />
                <data android:mimeType="video/mp4" />
                <data android:mimeType="video/x-msvideo" />
                <data android:mimeType="video/quicktime" />
                <data android:mimeType="video/x-flv" />
                <data android:mimeType="video/x-ms-wmv" />
                <data android:mimeType="video/webm" />
                <data android:mimeType="video/mp2ts" />
                <data android:mimeType="video/3gpp" />
                <data android:mimeType="video/3gpp2" />
                <data android:mimeType="video/x-m4v" />
                <data android:mimeType="video/mpeg" />
                <data android:mimeType="video/ogg" />
            </intent-filter>

            <!-- Audio formats that may not resolve to audio/* on all file managers -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/x-flac" />
                <data android:mimeType="audio/flac" />
                <data android:mimeType="audio/x-matroska" />
                <data android:mimeType="audio/x-wav" />
                <data android:mimeType="audio/ogg" />
                <data android:mimeType="audio/opus" />
                <data android:mimeType="audio/x-aiff" />
                <data android:mimeType="audio/mpeg" />
                <data android:mimeType="audio/mp4" />
                <data android:mimeType="audio/x-m4a" />
                <data android:mimeType="audio/x-ms-wma" />
                <data android:mimeType="audio/midi" />
            </intent-filter>

            <!-- Register as a network stream player: HLS (.m3u8), DASH (.mpd),
                 progressive media over HTTP(S), and RTSP. Matches intents that
                 carry an explicit media MIME type. MIME matching is CASE-SENSITIVE,
                 so both casings of the HLS types are listed; octet-stream is common
                 for streams/downloads served without a specific type. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:scheme="rtsp" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/x-mpegURL" />
                <data android:mimeType="application/x-mpegurl" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
                <data android:mimeType="application/mpegurl" />
                <data android:mimeType="audio/mpegurl" />
                <data android:mimeType="audio/x-mpegurl" />
                <data android:mimeType="application/dash+xml" />
                <data android:mimeType="video/mp2t" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Bare RTSP links carry no MIME type and no file extension, and the
                 scheme is inherently streaming media, so claim all of it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rtsp" />
            </intent-filter>

            <!-- Match streaming / media URLs by file extension when the sender
                 supplies no MIME type (browsers tapping a link, share sheets).
                 pathPattern works on all API levels but is fragile: its .* is lazy
                 and never backtracks, so it misses paths with a dot BEFORE the
                 extension (e.g. /live/1.5/index.m3u8) — hence the extra two-dot
                 variants for the key streaming types. pathSuffix (API 31+) matches
                 the end of the path exactly and is immune to that bug. A host
                 wildcard is required for any path attribute to apply. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.m3u8" />
                <data android:pathPattern=".*\\..*\\.m3u8" />
                <data android:pathPattern=".*\\.m3u" />
                <data android:pathPattern=".*\\.mpd" />
                <data android:pathPattern=".*\\..*\\.mpd" />
                <data android:pathPattern=".*\\.mp4" />
                <data android:pathPattern=".*\\..*\\.mp4" />
                <data android:pathPattern=".*\\.m4v" />
                <data android:pathPattern=".*\\.mkv" />
                <data android:pathPattern=".*\\.webm" />
                <data android:pathPattern=".*\\.avi" />
                <data android:pathPattern=".*\\.mov" />
                <data android:pathPattern=".*\\.flv" />
                <data android:pathPattern=".*\\.ts" />
                <data android:pathPattern=".*\\.mp3" />
                <data android:pathPattern=".*\\.flac" />
                <data android:pathPattern=".*\\.aac" />
                <data android:pathPattern=".*\\.ogg" />
                <data android:pathPattern=".*\\.opus" />
                <data android:pathPattern=".*\\.wav" />
                <data android:pathPattern=".*\\.m4a" />
                <data android:pathSuffix=".m3u8" />
                <data android:pathSuffix=".m3u" />
                <data android:pathSuffix=".mpd" />
                <data android:pathSuffix=".mp4" />
                <data android:pathSuffix=".m4v" />
                <data android:pathSuffix=".mkv" />
                <data android:pathSuffix=".webm" />
                <data android:pathSuffix=".avi" />
                <data android:pathSuffix=".mov" />
                <data android:pathSuffix=".flv" />
                <data android:pathSuffix=".ts" />
                <data android:pathSuffix=".mp3" />
                <data android:pathSuffix=".flac" />
                <data android:pathSuffix=".aac" />
                <data android:pathSuffix=".ogg" />
                <data android:pathSuffix=".opus" />
                <data android:pathSuffix=".wav" />
                <data android:pathSuffix=".m4a" />
            </intent-filter>

            <!-- Browser-style: claim EVERY http(s) URL, even type-less ones (plain
                 web page links), the way a browser registers. A filter that
                 declares a mimeType only matches typed intents, so this scheme-only
                 filter is what catches links with no MIME type at all. This makes
                 the app appear in the chooser for essentially any link tapped
                 anywhere. Delete this single filter to stop behaving like a browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- Browser Activity for in-app web browsing -->
        <activity
            android:name=".browser.BrowserActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@style/Theme.HzPlayer" />

        <!-- Media3 Playback Service for background audio -->
        <service
            android:name=".data.datasource.player.MediaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- FileProvider for installing APK updates -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
