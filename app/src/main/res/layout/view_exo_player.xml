<?xml version="1.0" encoding="utf-8"?>
<!--
    ExoPlayer PlayerView with TextureView surface type.

    TextureView keeps its last rendered frame alive in GPU memory even
    after onStop(), so the video does NOT flash black when the user
    briefly switches away and returns.

    SurfaceView (the default) punches a transparent hole in the window and
    the OS destroys the surface on every onStop(), causing the black flash.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/exo_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false" />
